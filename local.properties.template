# ============================================================
#  local.properties — API Key Configuration
#  Day 1 of 14: Project Skeleton + Build Configuration
# ============================================================
#
#  WHAT THIS FILE DOES:
#  --------------------
#  Stores secret keys that should NEVER be committed to GitHub.
#  The app/build.gradle file reads these values and injects them
#  into the app as BuildConfig fields.
#
#  ⚠️  IMPORTANT — ADD THIS LINE TO YOUR .gitignore:
#       local.properties
#
#  CONNECTIONS:
#  → app/build.gradle reads NEWS_API_KEY and injects it as BuildConfig.NEWS_API_KEY
#  → Day 2's Constants.kt accesses it via BuildConfig.NEWS_API_KEY
#  → Day 11's GeminiClient.kt accesses GEMINI_API_KEY via BuildConfig.GEMINI_API_KEY
#
#  HOW TO GET YOUR KEYS:
#  ----------------------
#  News API:   https://newsapi.org/register  (free, instant)
#  Gemini API: https://makersuite.google.com/app/apikey  (free, needs Google account)
# ============================================================

# Android SDK location (auto-generated by Android Studio — do not change)
sdk.dir=/Users/YOUR_USERNAME/Library/Android/sdk

# ------------------------------------------------------------------
# News API Key
# Get yours free at: https://newsapi.org/register
# Replace the placeholder below with your actual key
# ------------------------------------------------------------------
NEWS_API_KEY=your_news_api_key_here

# ------------------------------------------------------------------
# Google Gemini API Key (used in Day 11 for AI summarization)
# Get yours free at: https://makersuite.google.com/app/apikey
# You can leave this blank until Day 11 — the app works without it
# ------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
